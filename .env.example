# LLM_PROVIDER: qual IA o jogo usa. Aceita um nome ou uma lista separada por
# vírgula — o primeiro é o principal e os seguintes só entram se o anterior
# bater no limite do plano gratuito ou ficar fora do ar.
#   ollama      -> local, sem chave, só funciona com tudo rodando na sua máquina
#   groq        -> API hospedada gratuita, usada no deploy da Vercel
#   openrouter  -> API hospedada, útil como reserva da Groq
# Local:   LLM_PROVIDER=ollama
# Vercel:  LLM_PROVIDER=groq   (ou groq,openrouter)
LLM_PROVIDER=ollama

# usados quando LLM_PROVIDER inclui "ollama"
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# usados quando LLM_PROVIDER inclui "groq" (chave em console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# usados quando LLM_PROVIDER inclui "openrouter" (chave em openrouter.ai/keys;
# escolha um modelo gratuito, terminado em ":free", em openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
