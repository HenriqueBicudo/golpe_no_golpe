# LLM_PROVIDER: "ollama" (local, sem chave, só funciona rodando local) ou "groq" (API gratuita hospedada, usada no deploy da Vercel).
LLM_PROVIDER=ollama

# usados quando LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# usados quando LLM_PROVIDER=groq (configurar nas env vars do projeto na Vercel, não local)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
